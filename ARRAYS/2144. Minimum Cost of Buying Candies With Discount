class Solution {
public:
    int minimumCost(vector<int>& cost) {

        int n = cost.size();

        if(n < 3) {
            return accumulate(cost.begin(), cost.end(), 0);
        }

        sort(cost.begin(), cost.end(), greater<int>()); // descending

        int total = 0;

        for(int i = 0; i < n; i++) {
            if(i % 3 == 2) continue; // skip every 3rd (cheapest of group)
            total += cost[i];
        }

        return total;
    }
};
